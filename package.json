{
    "name": "fbproduction",
    "private": true,
    "workspaces": [
        "client",
        "server"
    ],
    "dependencies": {
        "concurrently": "^9.2.1"
    },
    "scripts": {
        "server": "npm run dev --prefix client",
        "client": "npm start --prefix server",
        "dev": "concurrently \"npm run server\" \"npm run client\""
    }
}
